# Copy to .env on the Spark. Set a model and key for each API you want to show.
# Keys stay on the Spark and are never sent to the browser.
ANTLING_OPENAI_API_KEY=
ANTLING_OPENAI_MODEL=
ANTLING_ANTHROPIC_API_KEY=
ANTLING_ANTHROPIC_MODEL=
ANTLING_ZAI_API_KEY=
ANTLING_ZAI_MODEL=
ANTLING_DEEPSEEK_API_KEY=
ANTLING_DEEPSEEK_MODEL=

# Any OpenAI-compatible /chat/completions endpoint (for example a local server).
# With an API key, the base URL must use HTTPS. Without a key, HTTP is allowed.
ANTLING_COMPAT_BASE_URL=
ANTLING_COMPAT_MODEL=
ANTLING_COMPAT_API_KEY=
